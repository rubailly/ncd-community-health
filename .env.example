# Copied to .env by `make up` on first run. Values marked <generated> are
# replaced with fresh random secrets; everything else can be edited.

# ── Host ports ────────────────────────────────────────────────────────────────
OPENMRS_PORT=8080
ERPNEXT_PORT=8000
DHIS2_PORT=8081
OPENFN_PORT=4000
WHATSAPP_PORT=9000

# ── OpenMRS ───────────────────────────────────────────────────────────────────
# The reference application's built-in administrator
OPENMRS_ADMIN_USER=admin
OPENMRS_ADMIN_PASSWORD=Admin123

# ── E-Buzima (ERPNext) ────────────────────────────────────────────────────────
ERPNEXT_ADMIN_PASSWORD=admin
ERPNEXT_DB_ROOT_PASSWORD=<generated>
# API key of the integration user OpenFn signs in as
ERPNEXT_API_USER=openfn@ebuzima.local
ERPNEXT_API_KEY=<generated>
ERPNEXT_API_SECRET=<generated>

# ── DHIS2 ─────────────────────────────────────────────────────────────────────
# DHIS2's built-in administrator
DHIS2_ADMIN_USER=admin
DHIS2_ADMIN_PASSWORD=district

# ── OpenFn Lightning ──────────────────────────────────────────────────────────
OPENFN_ADMIN_EMAIL=admin@ncd.local
OPENFN_ADMIN_PASSWORD=<generated>
OPENFN_API_TOKEN=<generated>
OPENFN_SECRET_KEY_BASE=<generated>
OPENFN_ENCRYPTION_KEY=<generated>
OPENFN_WORKER_SECRET=<generated>
OPENFN_WORKER_RUNS_PRIVATE_KEY=<generated>

# ── WhatsApp (local mock of the Cloud API) ────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=<generated>
WHATSAPP_PHONE_NUMBER_ID=100200300400500
